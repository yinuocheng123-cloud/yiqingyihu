{
  "name": "yiqingyihu-opc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run start:dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "lint": "npm run lint -w apps/server && npm run lint -w apps/web",
    "prisma:generate": "npm run prisma:generate -w apps/server",
    "prisma:migrate": "npm run prisma:migrate -w apps/server",
    "db:setup": "npm run db:setup -w apps/server"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
